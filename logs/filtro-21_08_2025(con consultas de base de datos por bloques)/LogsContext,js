import React, { createContext, useContext, useReducer, useRef } from 'react';

// Contexto para gestión centralizada de logs y estado de aplicación
const LogsContext = createContext();

// Tipos de acciones para el reducer
const ACTION_TYPES = {
  SET_LOADING: 'SET_LOADING',
  SET_ERROR: 'SET_ERROR',
  SET_SERVIDORES: 'SET_SERVIDORES',
  SET_DEPARTAMENTOS: 'SET_DEPARTAMENTOS',
  SET_HISTOGRAM_DATA: 'SET_HISTOGRAM_DATA',
  UPDATE_HISTOGRAM_DATA: 'UPDATE_HISTOGRAM_DATA'
};

// Reducer para manejar el estado
const logsReducer = (state, action) => {
  switch (action.type) {
    case ACTION_TYPES.SET_LOADING:
      return { ...state, cargando: action.payload };
    case ACTION_TYPES.SET_ERROR:
      return { ...state, error: action.payload, cargando: false };
    case ACTION_TYPES.SET_SERVIDORES:
      return { ...state, servidores: action.payload };
    case ACTION_TYPES.SET_DEPARTAMENTOS:
      return { ...state, departamentos: action.payload };
    case ACTION_TYPES.SET_HISTOGRAM_DATA:
      return { ...state, histogramaData: action.payload };
    case ACTION_TYPES.UPDATE_HISTOGRAM_DATA:
      return {
        ...state,
        histogramaData: {
          ...state.histogramaData,
          [action.payload.servidorId]: action.payload.datos
        }
      };
    default:
      return state;
  }
};

//Envuelve y provee el estado global
export const LogsProvider = ({ children }) => {
  const [state, dispatch] = useReducer(logsReducer, {
    servidores: [],
    histogramaData: {},
    departamentos: [],
    cargando: false,
    error: null
  });

// Cache para evitar llamadas redundantes
  const lastFetchTimeRef = useRef(0);
  const CACHE_DURATION = 5 * 60 * 1000; 

  const value = {
    ...state,
    dispatch,
    lastFetchTimeRef,
    CACHE_DURATION
  };

  return (
    <LogsContext.Provider value={value}>
      {children}
    </LogsContext.Provider>
  );
};

export const useLogs = () => {
  const context = useContext(LogsContext);
  if (!context) {
    throw new Error('useLogs debe usarse dentro de LogsProvider');
  }
  return context;
};
