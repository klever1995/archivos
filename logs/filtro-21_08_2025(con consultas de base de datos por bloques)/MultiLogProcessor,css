  background-repeat: no-repeat;
  background-position: right 10px center;
  background-size: 16px;
}

.dropdown-departamentos:hover {
  border-color: #4a6fa5;
}

.dropdown-departamentos:focus {
  outline: none;
  border-color: #4a6fa5;
